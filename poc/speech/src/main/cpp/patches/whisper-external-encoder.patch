+int whisper_mosaic_copy_encoder_input(
+        struct whisper_context * ctx,
+                       float * output,
+                         int   n_elements) {
+    if (!ctx || !ctx->state || !output || !ctx->state->mosaic_external_encoder) {
+        return -1;
+    }
+
+    auto & state = *ctx->state;
+    const auto & mel = state.mel;
+    const int n_ctx = state.exp_n_audio_ctx > 0
+            ? state.exp_n_audio_ctx
+            : ctx->model.hparams.n_audio_ctx;
+    const int n_mels = ctx->model.hparams.n_mels;
+    const int n_frames = 2*n_ctx;
+    const int expected = n_mels*n_frames;
+
+    if (n_elements != expected || mel.n_mel != n_mels) {
+        return -2;
+    }
+
+    std::fill(output, output + expected, 0.0f);
+    const int i1 = std::min(n_frames, mel.n_len);
+    for (int j = 0; j < n_mels; ++j) {
+        for (int i = 0; i < i1; ++i) {
+            output[j*n_frames + i] = mel.data[j*mel.n_len + i];
+        }
+    }
+
+    // Prevent stale embeddings from being reused for a new utterance.
+    state.mosaic_external_encoder_output.clear();
+    return 0;
+}
+
+int whisper_mosaic_set_encoder_output(
+        struct whisper_context * ctx,
+                 const float * data,
+                         int   n_elements) {
+    if (!ctx || !ctx->state || !data || !ctx->state->mosaic_external_encoder) {
+        return -1;
+    }
+
+    auto & state = *ctx->state;
+    const int n_ctx = state.exp_n_audio_ctx > 0
+            ? state.exp_n_audio_ctx
+            : ctx->model.hparams.n_audio_ctx;
+    const int expected = n_ctx*ctx->model.hparams.n_audio_state;
+    if (n_elements != expected) {
+        return -2;
+    }
+
+    state.mosaic_external_encoder_output.assign(data, data + n_elements);
+    return 0;
+}

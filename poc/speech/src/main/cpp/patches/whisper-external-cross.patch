+int whisper_mosaic_set_cross_output(whisper_context * ctx, const float * data, int n) {
+    if (!ctx || !ctx->state || !ctx->state->mosaic_external_encoder || !ctx->params.flash_attn ||
+        ctx->state->exp_n_audio_ctx > 0 || !data) return -1;
+    const auto & h = ctx->model.hparams;
+    if (n != h.n_text_layer*2*h.n_audio_ctx*h.n_audio_state) return -2;
+    for (int i = 0; i < n; ++i) if (!std::isfinite(data[i])) return -3;
+    ctx->state->mosaic_external_cross_output.assign(data, data+n);
+    return 0;
+}
+
+// Compute Q5 CPU K/V once, then compare every cache element against FP32 TPU
+// projections after the same cache dtype conversion. Does not run token decoding.
+int whisper_mosaic_compare_cross(whisper_context * ctx, const float * data, int n,
+        double * metrics, int n_metrics, ggml_abort_callback abort_cb, void * abort_data) {
+    if (!ctx || !ctx->state || !data || !metrics || !ctx->params.flash_attn ||
+        !ctx->state->mosaic_external_encoder || ctx->state->exp_n_audio_ctx > 0) return -1;
+    auto & state = *ctx->state;
+    const auto & h = ctx->model.hparams;
+    const size_t count = size_t(h.n_audio_ctx)*h.n_audio_state;
+    const size_t padded = size_t(GGML_PAD(h.n_audio_ctx,256))*h.n_audio_state;
+    if (size_t(n) != size_t(h.n_text_layer)*2*count || n_metrics != h.n_text_layer*2*3) return -2;
+    state.mosaic_external_cross_output.clear();
+    if (!whisper_encode_internal(*ctx, state, 0, 2, abort_cb, abort_data)) return -3;
+    std::vector<float> reference(count);
+    for (int layer=0; layer<h.n_text_layer; ++layer) {
+        for (int kv=0; kv<2; ++kv) {
+            ggml_tensor * tensor = kv == 0 ? state.kv_cross.k : state.kv_cross.v;
+            const size_t offset = size_t(layer)*padded*ggml_element_size(tensor);
+            if (tensor->type == GGML_TYPE_F16) {
+                std::vector<ggml_fp16_t> half(count);
+                ggml_backend_tensor_get(tensor, half.data(), offset, count*sizeof(ggml_fp16_t));
+                ggml_fp16_to_fp32_row(half.data(), reference.data(), count);
+            } else if (tensor->type == GGML_TYPE_F32) {
+                ggml_backend_tensor_get(tensor, reference.data(), offset, count*sizeof(float));
+            } else return -4;
+            const float * candidate = data + (layer*2+kv)*count;
+            double diff_sq=0, ref_sq=0, cand_sq=0, dot=0, max_abs=0;
+            for (size_t i=0; i<count; ++i) {
+                if ((i % 65536 == 0) && abort_cb && abort_cb(abort_data)) return -5;
+                double a=reference[i];
+                double b=tensor->type == GGML_TYPE_F16
+                        ? ggml_fp16_to_fp32(ggml_fp32_to_fp16(candidate[i])) : candidate[i];
+                if (!std::isfinite(a) || !std::isfinite(b)) return -6;
+                double d=a-b;
+                diff_sq+=d*d; ref_sq+=a*a; cand_sq+=b*b; dot+=a*b;
+                max_abs=std::max(max_abs,std::abs(d));
+            }
+            const int m=(layer*2+kv)*3;
+            metrics[m]=max_abs;
+            metrics[m+1]=sqrt(diff_sq/std::max(ref_sq,1e-20));
+            metrics[m+2]=dot/sqrt(std::max(ref_sq*cand_sq,1e-20));
+        }
+    }
     return 0;
 }
 

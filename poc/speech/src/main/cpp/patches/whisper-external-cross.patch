+// Mosaic layout: [layer, K/V, frame, channel]. Padding is zeroed per layer.
+static bool mosaic_write_cross(whisper_context & ctx, whisper_state & state) {
+    const int frames = ctx.model.hparams.n_audio_ctx;
+    const int dim = ctx.model.hparams.n_audio_state;
+    const int layers = ctx.model.hparams.n_text_layer;
+    const size_t count = size_t(frames)*dim;
+    const size_t padded = size_t(GGML_PAD(frames, 256))*dim;
+    if (!ctx.params.flash_attn || state.exp_n_audio_ctx > 0 ||
+        state.mosaic_external_cross_output.size() != size_t(layers)*2*count) return false;
+    for (int kv = 0; kv < 2; ++kv) {
+        ggml_tensor * tensor = kv == 0 ? state.kv_cross.k : state.kv_cross.v;
+        if (tensor->type != GGML_TYPE_F16 && tensor->type != GGML_TYPE_F32) return false;
+        if (ggml_nbytes(tensor) < size_t(layers)*padded*ggml_element_size(tensor)) return false;
+        for (int layer = 0; layer < layers; ++layer) {
+            const float * source = state.mosaic_external_cross_output.data() + (layer*2 + kv)*count;
+            const size_t offset = size_t(layer)*padded*ggml_element_size(tensor);
+            if (tensor->type == GGML_TYPE_F16) {
+                std::vector<ggml_fp16_t> data(padded, ggml_fp32_to_fp16(0));
+                ggml_fp32_to_fp16_row(source, data.data(), count);
+                ggml_backend_tensor_set(tensor, data.data(), offset, padded*sizeof(ggml_fp16_t));
+            } else {
+                std::vector<float> data(padded, 0);
+                std::copy(source, source + count, data.begin());
+                ggml_backend_tensor_set(tensor, data.data(), offset, padded*sizeof(float));
+            }
+        }
+    }
+    return true;
+}

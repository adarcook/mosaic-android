<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="life.mosaic.permission.LOCAL_VOICE_ASR" />
    <queries><package android:name="life.mosaic.tensorwhisper" /><package android:name="life.mosaic.zipformergate" /></queries>
    <application android:label="מוזאיק — שיחה" android:allowBackup="false"
        android:extractNativeLibs="true" android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name="life.mosaic.models.ModelSetupActivity" android:exported="false" />
        <activity android:name=".VoiceActivity" android:exported="true" android:launchMode="singleTop" android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|uiMode" android:theme="@style/Theme.Mosaic.Voice">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".WakeEventReceiver" android:exported="false" />
        <service android:name=".TurnForegroundService" android:exported="false" android:foregroundServiceType="microphone|mediaPlayback" />
        <service android:name=".MosaicAssistantService" android:permission="android.permission.BIND_VOICE_INTERACTION" android:exported="true">
            <intent-filter><action android:name="android.service.voice.VoiceInteractionService" /></intent-filter>
            <meta-data android:name="android.voice_interaction" android:resource="@xml/voice_interaction" />
        </service>
        <service android:name=".MosaicSessionService" android:permission="android.permission.BIND_VOICE_INTERACTION" android:exported="true" />
        <activity android:name=".TtsSetupActivity" android:exported="false" />
        <activity android:name=".PersonalCommandsActivity" android:exported="false" android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|uiMode" android:theme="@style/Theme.Mosaic.Voice" />
        <service android:name=".TtsService" android:exported="false" android:process=":tts" />
        <service android:name=".WhatsAppNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <uses-native-library android:name="libedgetpu_litert.so" android:required="false" />
        <activity android:name=".LlmActivity" android:exported="true" android:hardwareAccelerated="false">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-ndjson" />
            </intent-filter>
        </activity>
        <service android:name=".LlmService" android:exported="false" android:process=":llm" />
    </application>
</manifest>
